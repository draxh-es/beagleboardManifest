<?xml version="1.0" encoding="UTF-8"?>
<!--
  BeagleBone Black AGL - repo manifest (giris noktasi)

  Kullanim:
    repo init -u https://github.com/draxh-es/beagleboardManifest.git -b main
    repo sync -j8

  Ayrintilar: README.md
-->
<manifest>

  <!-- AGL Unagi agaci: tum projeler bir commit SHA degerine sabit.
       "repo manifest -r" ile uretilir, elle duzenlenmez. -->
  <include name="agl-unagi-pinned.xml"/>

  <!-- Kendi depolarimiz. fetch="." bu manifest deposuyla ayni
       GitHub hesabi (draxh-es) demektir; repo init hangi protokolle
       (HTTPS ya da SSH) yapildiysa katman da onunla indirilir. -->
  <remote name="beagle" fetch="."/>

  <!-- BBB katmani: AGL'den kaldirilan beaglebone makine sablonu.
       Gelistirme surecinde main dalini izler. -->
  <project name="meta-BBB" path="meta-BBB" remote="beagle" revision="main"/>

</manifest>
